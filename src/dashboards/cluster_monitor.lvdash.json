{
  "datasets": [
    {
      "name": "cluster_hourly",
      "displayName": "Cluster hourly",
      "query": "SELECT\n  hour_utc,\n  cluster_name,\n  access_mode,\n  compute_purpose,\n  cluster_source,\n  data_security_mode,\n  owned_by,\n  dbr_version,\n  driver_node_type,\n  worker_node_type,\n  active_minutes,\n  active_instances,\n  ROUND(node_hours, 2) AS node_hours,\n  avg_cpu_pct,\n  peak_cpu_pct,\n  avg_memory_pct,\n  peak_memory_pct\nFROM v_cluster_hourly\nORDER BY hour_utc DESC\nLIMIT 5000"
    },
    {
      "name": "cluster_summary",
      "displayName": "Cluster summary",
      "query": "SELECT\n  COUNT(DISTINCT cluster_id) AS clusters,\n  ROUND(SUM(node_hours), 1) AS total_node_hours,\n  ROUND(AVG(avg_cpu_pct), 1) AS avg_cpu_pct,\n  ROUND(AVG(avg_memory_pct), 1) AS avg_memory_pct\nFROM v_cluster_hourly\nWHERE hour_utc >= CURRENT_TIMESTAMP() - INTERVAL 24 HOURS"
    },
    {
      "name": "by_access_mode",
      "displayName": "By access mode",
      "query": "SELECT\n  access_mode,\n  COUNT(DISTINCT cluster_id) AS clusters,\n  ROUND(SUM(node_hours), 1) AS node_hours,\n  ROUND(AVG(avg_cpu_pct), 1) AS avg_cpu_pct,\n  ROUND(AVG(avg_memory_pct), 1) AS avg_memory_pct\nFROM v_cluster_hourly\nWHERE hour_utc >= CURRENT_TIMESTAMP() - INTERVAL 7 DAYS\nGROUP BY access_mode\nORDER BY node_hours DESC"
    },
    {
      "name": "by_compute_purpose",
      "displayName": "By compute purpose",
      "query": "SELECT\n  compute_purpose,\n  access_mode,\n  COUNT(DISTINCT cluster_id) AS clusters,\n  ROUND(SUM(node_hours), 1) AS node_hours\nFROM v_cluster_hourly\nWHERE hour_utc >= CURRENT_TIMESTAMP() - INTERVAL 7 DAYS\nGROUP BY compute_purpose, access_mode\nORDER BY node_hours DESC"
    },
    {
      "name": "compute_type_summary",
      "displayName": "Compute type DBUs",
      "query": "SELECT\n  compute_type,\n  ROUND(SUM(usage_quantity), 1) AS dbus,\n  COUNT(DISTINCT usage_date) AS days_active\nFROM compute_usage_by_type\nWHERE usage_date >= CURRENT_DATE() - INTERVAL 7 DAYS\nGROUP BY compute_type\nORDER BY dbus DESC"
    },
    {
      "name": "compute_type_daily",
      "displayName": "Compute type daily",
      "query": "SELECT\n  usage_date,\n  compute_type,\n  ROUND(SUM(usage_quantity), 1) AS dbus\nFROM compute_usage_by_type\nWHERE usage_date >= CURRENT_DATE() - INTERVAL 30 DAYS\nGROUP BY usage_date, compute_type\nORDER BY usage_date DESC, dbus DESC"
    }
  ],
