{
  "datasets": [
    {
      "name": "unified_runs",
      "displayName": "Unified runs",
      "query": "SELECT\n  run_category,\n  job_type,\n  entity_name,\n  status,\n  trigger_type,\n  execution_type,\n  start_time,\n  end_time,\n  duration_seconds,\n  executed_by,\n  termination_code\nFROM unified_runs\nORDER BY start_time DESC\nLIMIT 5000"
    },
    {
      "name": "run_summary",
      "displayName": "Run summary",
      "query": "SELECT\n  COUNT(*) AS total_runs,\n  SUM(CASE WHEN status IN ('FAILED', 'ERROR') THEN 1 ELSE 0 END) AS failed_runs,\n  SUM(CASE WHEN status IN ('SUCCEEDED', 'SUCCESS') THEN 1 ELSE 0 END) AS succeeded_runs,\n  SUM(CASE WHEN status = 'RUNNING' THEN 1 ELSE 0 END) AS running_runs,\n  ROUND(AVG(duration_seconds), 0) AS avg_duration_seconds\nFROM unified_runs\nWHERE start_time >= CURRENT_TIMESTAMP() - INTERVAL 24 HOURS"
    },
    {
      "name": "runs_by_category",
      "displayName": "Runs by category",
      "query": "SELECT\n  run_category,\n  COUNT(*) AS runs,\n  SUM(CASE WHEN status IN ('FAILED', 'ERROR') THEN 1 ELSE 0 END) AS failed,\n  ROUND(AVG(duration_seconds), 0) AS avg_duration_seconds\nFROM unified_runs\nWHERE start_time >= CURRENT_TIMESTAMP() - INTERVAL 7 DAYS\nGROUP BY run_category\nORDER BY runs DESC"
    },
    {
      "name": "runs_by_job_type",
      "displayName": "Runs by job type",
      "query": "SELECT\n  job_type,\n  run_category,\n  COUNT(*) AS runs,\n  SUM(CASE WHEN status IN ('FAILED', 'ERROR') THEN 1 ELSE 0 END) AS failed,\n  SUM(CASE WHEN status IN ('SUCCEEDED', 'SUCCESS') THEN 1 ELSE 0 END) AS succeeded,\n  ROUND(AVG(duration_seconds), 0) AS avg_duration_seconds,\n  ROUND(PERCENTILE(duration_seconds, 0.95), 0) AS p95_duration_seconds\nFROM unified_runs\nWHERE start_time >= CURRENT_TIMESTAMP() - INTERVAL 7 DAYS\nGROUP BY job_type, run_category\nORDER BY runs DESC"
    },
    {
      "name": "runs_by_trigger",
      "displayName": "Runs by trigger",
      "query": "SELECT\n  trigger_type,\n  job_type,\n  COUNT(*) AS runs,\n  SUM(CASE WHEN status IN ('FAILED', 'ERROR') THEN 1 ELSE 0 END) AS failed,\n  ROUND(AVG(duration_seconds), 0) AS avg_duration_seconds\nFROM unified_runs\nWHERE start_time >= CURRENT_TIMESTAMP() - INTERVAL 7 DAYS\nGROUP BY trigger_type, job_type\nORDER BY runs DESC"
    },
    {
      "name": "runs_by_status_type",
      "displayName": "Status by job type",
      "query": "SELECT\n  job_type,\n  status,\n  COUNT(*) AS runs,\n  ROUND(AVG(duration_seconds), 0) AS avg_duration_seconds\nFROM unified_runs\nWHERE start_time >= CURRENT_TIMESTAMP() - INTERVAL 7 DAYS\nGROUP BY job_type, status\nORDER BY job_type, runs DESC"
    }
  ],
