{
  "datasets": [
    {
      "name": "api_runs",
      "displayName": "API submitted runs",
      "query": "SELECT\n  recency_rank,\n  job_nm,\n  run_name,\n  run_id,\n  job_id,\n  submitted_by,\n  submit_channel,\n  start_time,\n  end_time,\n  status,\n  duration_seconds,\n  ROUND(dbu_consumed, 2) AS dbu_consumed,\n  cluster_names,\n  cluster_running_on,\n  compute_billing_type,\n  job_parameters_json AS parameters\nFROM api_submitted_runs\nORDER BY recency_rank"
    },
    {
      "name": "api_run_summary",
      "displayName": "API run summary",
      "query": "SELECT\n  COUNT(*) AS total_runs,\n  SUM(CASE WHEN status IN ('FAILED', 'ERROR', 'TIMEDOUT') THEN 1 ELSE 0 END) AS failed_runs,\n  SUM(CASE WHEN status IN ('SUCCEEDED', 'SUCCESS') THEN 1 ELSE 0 END) AS succeeded_runs,\n  ROUND(SUM(dbu_consumed), 1) AS total_dbus,\n  ROUND(AVG(dbu_consumed), 2) AS avg_dbus\nFROM api_submitted_runs"
    }
  ],
  "pages": [
    {
      "name": "main",
      "displayName": "API Submit Monitor",
      "layout": [
        {
          "position": { "x": 0, "y": 0, "width": 6, "height": 1 },
          "widget": {
            "name": "title",
            "textbox_spec": "# API Submit Monitor\nSearch by **job name**. Table is `api_submitted_runs` only. Row count is bundle var `api_submit_last_n_runs` (default 100)."
          }
        },
        {
          "position": { "x": 0, "y": 1, "width": 3, "height": 1 },
          "widget": {
            "name": "filter_job_nm",
            "queries": [
              {
                "name": "filter_job_nm",
                "query": {
                  "datasetName": "api_runs",
                  "disaggregated": false,
                  "fields": [
                    { "expression": "`job_nm`", "name": "job_nm" },
                    { "expression": "COUNT_IF(`associative_filter_predicate_group`)", "name": "job_nm_associativity" }
                  ]
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "frame": { "showTitle": true, "title": "Search job name" },
              "encodings": {
                "fields": [
                  {
                    "displayName": "Job name",
                    "fieldName": "job_nm",
                    "queryName": "filter_job_nm"
                  }
                ]
              }
            }
          }
        },
        {
          "position": { "x": 3, "y": 1, "width": 3, "height": 1 },
          "widget": {
            "name": "filter_run_name",
            "queries": [
              {
                "name": "filter_run_name",
                "query": {
                  "datasetName": "api_runs",
                  "disaggregated": false,
                  "fields": [
                    { "expression": "`run_name`", "name": "run_name" },
                    { "expression": "COUNT_IF(`associative_filter_predicate_group`)", "name": "run_name_associativity" }
                  ]
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "frame": { "showTitle": true, "title": "Search run_name" },
              "encodings": {
                "fields": [
                  {
                    "displayName": "Run name",
                    "fieldName": "run_name",
                    "queryName": "filter_run_name"
                  }
                ]
              }
            }
          }
        },
        {
          "position": { "x": 0, "y": 2, "width": 1, "height": 2 },
          "widget": {
            "name": "kpi_total",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "api_run_summary",
                  "disaggregated": false,
                  "fields": [{ "expression": "`total_runs`", "name": "total_runs" }]
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": { "showTitle": true, "title": "Runs (last N)" },
              "encodings": {
                "value": { "fieldName": "total_runs", "displayName": "Runs" }
              }
            }
          }
        },
        {
          "position": { "x": 1, "y": 2, "width": 1, "height": 2 },
          "widget": {
            "name": "kpi_ok",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "api_run_summary",
                  "disaggregated": false,
                  "fields": [{ "expression": "`succeeded_runs`", "name": "succeeded_runs" }]
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": { "showTitle": true, "title": "Succeeded" },
              "encodings": {
                "value": { "fieldName": "succeeded_runs", "displayName": "Succeeded" }
              }
            }
          }
        },
        {
          "position": { "x": 2, "y": 2, "width": 1, "height": 2 },
          "widget": {
            "name": "kpi_failed",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "api_run_summary",
                  "disaggregated": false,
                  "fields": [{ "expression": "`failed_runs`", "name": "failed_runs" }]
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": { "showTitle": true, "title": "Failed" },
              "encodings": {
                "value": { "fieldName": "failed_runs", "displayName": "Failed" }
              }
            }
          }
        },
        {
          "position": { "x": 3, "y": 2, "width": 1, "height": 2 },
          "widget": {
            "name": "kpi_dbus",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "api_run_summary",
                  "disaggregated": false,
                  "fields": [{ "expression": "`total_dbus`", "name": "total_dbus" }]
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": { "showTitle": true, "title": "Total DBUs" },
              "encodings": {
                "value": { "fieldName": "total_dbus", "displayName": "DBUs" }
              }
            }
          }
        },
        {
          "position": { "x": 4, "y": 2, "width": 2, "height": 2 },
          "widget": {
            "name": "kpi_avg_dbus",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "api_run_summary",
                  "disaggregated": false,
                  "fields": [{ "expression": "`avg_dbus`", "name": "avg_dbus" }]
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": { "showTitle": true, "title": "Avg DBUs / run" },
              "encodings": {
                "value": { "fieldName": "avg_dbus", "displayName": "Avg DBUs" }
              }
            }
          }
        },
        {
          "position": { "x": 0, "y": 4, "width": 6, "height": 12 },
          "widget": {
            "name": "runs_table",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "api_runs",
                  "disaggregated": true,
                  "fields": [
                    { "expression": "`job_nm`", "name": "job_nm" },
                    { "expression": "`run_name`", "name": "run_name" },
                    { "expression": "`cluster_names`", "name": "cluster_names" },
                    { "expression": "`cluster_running_on`", "name": "cluster_running_on" },
                    { "expression": "`dbu_consumed`", "name": "dbu_consumed" },
                    { "expression": "`start_time`", "name": "start_time" },
                    { "expression": "`end_time`", "name": "end_time" },
                    { "expression": "`status`", "name": "status" },
                    { "expression": "`submitted_by`", "name": "submitted_by" },
                    { "expression": "`parameters`", "name": "parameters" },
                    { "expression": "`run_id`", "name": "run_id" }
                  ]
                }
              }
            ],
            "spec": {
              "version": 1,
              "widgetType": "table",
              "frame": { "showTitle": true, "title": "API job runs" },
              "itemsPerPage": 50,
              "encodings": {
                "columns": [
                  { "fieldName": "job_nm", "displayName": "Job name", "type": "string", "visible": true },
                  { "fieldName": "run_name", "displayName": "Run name", "type": "string", "visible": true },
                  { "fieldName": "cluster_names", "displayName": "Cluster name", "type": "string", "visible": true },
                  { "fieldName": "cluster_running_on", "displayName": "Cluster running on", "type": "string", "visible": true },
                  { "fieldName": "dbu_consumed", "displayName": "DBU", "type": "float", "visible": true },
                  { "fieldName": "start_time", "displayName": "Start time", "type": "datetime", "visible": true },
                  { "fieldName": "end_time", "displayName": "End time", "type": "datetime", "visible": true },
                  { "fieldName": "status", "displayName": "Status", "type": "string", "visible": true },
                  { "fieldName": "submitted_by", "displayName": "Submitted by", "type": "string", "visible": true },
                  { "fieldName": "parameters", "displayName": "Parameters", "type": "string", "visible": true },
                  { "fieldName": "run_id", "displayName": "Run ID", "type": "string", "visible": true }
                ]
              }
            }
          }
        }
      ]
    }
  ]
}
