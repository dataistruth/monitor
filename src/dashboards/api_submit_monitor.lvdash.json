{
  "datasets": [
    {
      "name": "api_runs",
      "displayName": "API submitted runs",
      "query": "SELECT\n  recency_rank,\n  job_nm,\n  run_id,\n  job_id,\n  submitted_by,\n  submit_channel,\n  run_type,\n  trigger_type,\n  status,\n  termination_code,\n  start_time,\n  end_time,\n  duration_seconds,\n  ROUND(dbu_consumed, 3) AS dbu_consumed,\n  ROUND(cluster_dbu_during_run, 3) AS cluster_dbu_during_run,\n  COALESCE(compute_billing_type, 'CLASSIC') AS compute_billing_type,\n  cluster_running_on,\n  cluster_names,\n  cluster_ids,\n  cluster_sources,\n  cluster_access_modes,\n  parameter_keys,\n  job_parameters_json\nFROM api_submitted_runs\nORDER BY recency_rank"
    },
    {
      "name": "api_run_summary",
      "displayName": "API run summary",
      "query": "SELECT\n  COUNT(*) AS total_runs,\n  SUM(CASE WHEN status IN ('SUCCEEDED', 'SUCCESS') THEN 1 ELSE 0 END) AS succeeded_runs,\n  SUM(CASE WHEN status IN ('FAILED', 'ERROR', 'TIMEDOUT') THEN 1 ELSE 0 END) AS failed_runs,\n  ROUND(SUM(cluster_dbu_during_run), 1) AS total_dbus,\n  ROUND(AVG(duration_seconds), 0) AS avg_run_seconds\nFROM api_submitted_runs\nWHERE start_time >= CURRENT_TIMESTAMP() - INTERVAL 24 HOURS"
    }
  ],
  "pages": [
    {
      "name": "main",
      "displayName": "API Submit Monitor",
      "layout": [
        {
          "position": {
            "x": 0,
            "y": 0,
